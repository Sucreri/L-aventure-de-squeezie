# =============================================================================
# Example environment file. NEVER commit real keys. Copy to .env and fill in.
# Every operational value below is ALSO a row in `app_settings` (DB) when it is
# a business parameter. This file only holds infrastructure credentials and
# endpoints, per spec rule 0.3 ("nothing hard-coded").
# =============================================================================

# --- Application identity (brand name is provisional until BOIP/EUIPO clearance)
APP_NAME="Palette"
APP_DEFAULT_LOCALE="fr"
APP_SUPPORTED_LOCALES="fr,en,nl"

# --- Supabase / Postgres (EU region only, see COMPLIANCE.md C-RGPD-07)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""

# --- Payment provider: "mollie" or "stripe" (both must support Bancontact + SCA)
PAYMENT_PROVIDER="mollie"
MOLLIE_API_KEY=""
MOLLIE_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Age / identity verification provider
AGE_VERIFICATION_PROVIDER="itsme"
ITSME_CLIENT_ID=""
ITSME_CLIENT_SECRET=""
ITSME_REDIRECT_URI=""

# --- Courier expense cards (corporate cards, per-mission ceiling)
SPEND_CARD_PROVIDER=""
SPEND_CARD_API_KEY=""

# --- Payroll office (social secretariat) export target
PAYROLL_EXPORT_MODE="csv"          # csv | api
PAYROLL_API_BASE_URL=""
PAYROLL_API_KEY=""

# --- Maps / routing
MAP_PROVIDER="mapbox"              # mapbox | google
MAPBOX_ACCESS_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# --- Messaging
SMS_PROVIDER=""
SMS_API_KEY=""
TRANSACTIONAL_EMAIL_PROVIDER=""
TRANSACTIONAL_EMAIL_API_KEY=""
PUSH_PROVIDER="expo"

# --- Observability (no personal data in logs, see COMPLIANCE.md C-SEC-05)
SENTRY_DSN=""
LOG_LEVEL="info"
