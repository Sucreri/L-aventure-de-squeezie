{
  "name": "palette-mvp",
  "private": true,
  "version": "0.1.0",
  "description": "MVP de livraison de boissons et snacks à Louvain-la-Neuve (nom de travail : Palette)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types packages/domain/tests/*.test.ts",
    "test:services": "scripts/test-services.sh",
    "test:db": "scripts/test-db.sh",
    "test:parity": "scripts/check-parity.sh",
    "test:all": "npm test && npm run test:db && npm run test:parity && npm run test:services && npm run test:api && npm run test:app",
    "db:reset": "scripts/db-reset.sh --seed",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:api": "scripts/test-api.sh",
    "dev:api": "node --experimental-strip-types apps/api/src/main.ts",
    "test:app": "scripts/test-app.sh",
    "dev:app": "npm --workspace @palette/mobile run web"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
